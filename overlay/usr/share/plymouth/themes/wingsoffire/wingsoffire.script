# Wings of Fire OS boot splash: the emblem inside a spinning ring, with the wordmark below.
# Also shows the disk-encryption password prompt and boot messages.
# Images are generated by scripts/make-artwork.py; spinner.png is drawn at bootlogo.png's scale,
# so both are scaled by the same factor and share the emblem's centre.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# Emblem circle within the 500x500 bootlogo.png, and the 540x540 spinner.png.
emblem_cx = 251;
emblem_cy = 242.5;
spinner_px = 540;

scale = Math.Min(screen_w, screen_h) * 0.34 / 500;
logo_image = Image("bootlogo.png");
logo_image = logo_image.Scale(Math.Int(500 * scale), Math.Int(500 * scale));
spinner_image = Image("spinner.png");
spinner_image = spinner_image.Scale(Math.Int(spinner_px * scale), Math.Int(spinner_px * scale));

wordmark_image = Image("wordmark-wide.png");
wordmark_h = screen_h * 0.085;
wordmark_w = wordmark_image.GetWidth() * wordmark_h / wordmark_image.GetHeight();
if (wordmark_w > screen_w * 0.85) {
  wordmark_w = screen_w * 0.85;
  wordmark_h = wordmark_image.GetHeight() * wordmark_w / wordmark_image.GetWidth();
}
wordmark_image = wordmark_image.Scale(Math.Int(wordmark_w), Math.Int(wordmark_h));

gap = screen_h * 0.04;
top = (screen_h - (spinner_px * scale + gap + wordmark_h)) / 2;
centre_x = screen_w / 2;
centre_y = top + spinner_px * scale / 2;

logo = Sprite(logo_image);
logo.SetPosition(centre_x - emblem_cx * scale, centre_y - emblem_cy * scale, 1);
spinner = Sprite(spinner_image);
spinner.SetPosition(centre_x - spinner_px * scale / 2, centre_y - spinner_px * scale / 2, 2);
wordmark = Sprite(wordmark_image);
wordmark.SetPosition(centre_x - wordmark_w / 2, top + spinner_px * scale + gap, 1);

text_y = top + spinner_px * scale + gap + wordmark_h + 30;
frame = 0;
angle = 0;

fun set_opacity(value) {
  global.logo.SetOpacity(value);
  global.spinner.SetOpacity(value);
  global.wordmark.SetOpacity(value);
}
set_opacity(0);

fun refresh_callback() {
  global.frame = global.frame + 1;
  set_opacity(Math.Min(global.frame / 40, 1));
  global.angle = global.angle + 0.08;
  global.spinner.SetImage(global.spinner_image.Rotate(global.angle));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun centred_text(text, y) {
  image = Image.Text(text, 1, 1, 1);
  sprite = Sprite(image);
  sprite.SetPosition(global.screen_w / 2 - image.GetWidth() / 2, y, 10);
  return sprite;
}

fun display_password_callback(prompt, bullets) {
  stars = "";
  for (i = 0; i < bullets; i = i + 1) {
    stars = stars + "*";
  }
  if (stars == "") {
    stars = " ";
  }
  global.prompt_sprite = centred_text(prompt, global.text_y);
  global.bullet_sprite = centred_text(stars, global.text_y + 30);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  global.prompt_sprite.SetOpacity(0);
  global.bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  global.message_sprite = centred_text(text, global.screen_h - 60);
}
Plymouth.SetMessageFunction(message_callback);
