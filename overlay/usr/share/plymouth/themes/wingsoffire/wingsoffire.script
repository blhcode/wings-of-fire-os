# Wings of Fire OS boot splash: the emblem fades in on black and gently pulses.
# Also shows the disk-encryption password prompt and boot messages.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo_image = Image("bootlogo.png");
logo_size = Math.Int(Math.Min(screen_w, screen_h) * 0.4);
if (logo_size < logo_image.GetWidth()) {
  logo_image = logo_image.Scale(logo_size, logo_size);
}
logo = Sprite(logo_image);
logo.SetPosition(screen_w / 2 - logo_image.GetWidth() / 2, screen_h / 2 - logo_image.GetHeight() / 2, 0);
logo.SetOpacity(0);

text_y = screen_h / 2 + logo_image.GetHeight() / 2 + 40;
frame = 0;

fun refresh_callback() {
  global.frame = global.frame + 1;
  fade_in = Math.Min(global.frame / 50, 1);
  pulse = 0.85 + 0.15 * Math.Sin(global.frame / 25);
  global.logo.SetOpacity(fade_in * pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun centred_text(text, y) {
  image = Image.Text(text, 1, 1, 1);
  sprite = Sprite(image);
  sprite.SetPosition(global.screen_w / 2 - image.GetWidth() / 2, y, 10);
  return sprite;
}

fun display_password_callback(prompt, bullets) {
  stars = "";
  for (i = 0; i < bullets; i = i + 1) {
    stars = stars + "*";
  }
  if (stars == "") {
    stars = " ";
  }
  global.prompt_sprite = centred_text(prompt, global.text_y);
  global.bullet_sprite = centred_text(stars, global.text_y + 30);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  global.prompt_sprite.SetOpacity(0);
  global.bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  global.message_sprite = centred_text(text, global.screen_h - 60);
}
Plymouth.SetMessageFunction(message_callback);
